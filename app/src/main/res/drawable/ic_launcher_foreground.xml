<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      Hourglass caught mid-flow. Everything sits inside the adaptive-icon safe
      zone (the centre 66dp), so no launcher mask clips it.
    -->

    <!-- upper chamber -->
    <path
        android:pathData="M38,30 L70,30 L54,54 Z"
        android:strokeColor="#0A0A0C"
        android:strokeWidth="7"
        android:strokeLineJoin="round" />

    <!-- sand still to fall -->
    <path
        android:pathData="M46,42 L62,42 L54,54 Z"
        android:fillColor="#0A0A0C" />

    <!-- the stream through the waist -->
    <path
        android:pathData="M54,55 L54,66"
        android:strokeColor="#0A0A0C"
        android:strokeWidth="5"
        android:strokeLineCap="round" />

    <!-- lower chamber -->
    <path
        android:pathData="M38,78 L70,78 L54,54 Z"
        android:strokeColor="#0A0A0C"
        android:strokeWidth="7"
        android:strokeLineJoin="round" />

    <!-- sand already fallen -->
    <path
        android:pathData="M44.7,68 L63.3,68 L70,78 L38,78 Z"
        android:fillColor="#0A0A0C" />
</vector>
